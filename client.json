{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "protocol": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ],
        "routeOnly": true
      },
      "settings": {
        "auth": "noauth",
        "udp": true,
        "allowTransparent": false
      }
    },
    {
      "tag": "http-in",
      "protocol": "http",
      "listen": "127.0.0.1",
      "port": 10809,
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ],
        "routeOnly": true
      },
      "settings": {
        "auth": "noauth",
        "udp": true,
        "allowTransparent": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "xray服务器ip",
            "port": 0,
            "users": [
              {
                "id": "xray的uuid",
                "encryption": "none",
                "flow": "xtls-rprx-vision",
                "level": 0
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "换成你的域名",
          "allowInsecure": false,
          "fingerprint": "chrome"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "UseIP",
        "userLevel": 0
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      }
    }
  ],
  "policy": {
    "system": {
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "dns": {
    "hosts": {
      "dns.google": [
        "8.8.8.8",
        "8.8.4.4"
      ]
    },
    "servers": [
      {
        "address": "1.1.1.1",
        "domains": [
          "geosite:geolocation-!cn",
          "geosite:google-cn"
        ],
        "expectIPs": [
          "geoip:!cn"
        ],
        "skipFallback": false
      },
      {
        "address": "https://1.1.1.1/dns-query",
        "domains": [
          "geosite:geolocation-!cn",
          "geosite:google-cn"
        ],
        "expectIPs": [
          "geoip:!cn"
        ],
        "skipFallback": false,
        "queryStrategy": "UseIPv4"
      },
      "8.8.8.8",
      "8.8.4.4",
      "1.1.1.1",
      {
        "address": "localhost",
        "domains": [
          "geosite:cn",
          "geosite:geolocation-cn",
          "geosite:apple-cn"
        ],
        "expectIPs": [
          "geoip:cn"
        ],
        "skipFallback": true
      },
      {
        "address": "local://223.5.5.5",
        "domains": [
          "geosite:cn",
          "geosite:geolocation-cn",
          "geosite:apple-cn"
        ],
        "expectIPs": [
          "geoip:cn"
        ],
        "skipFallback": true
      },
      {
        "address": "local://119.29.29.29",
        "domains": [
          "geosite:cn",
          "geosite:geolocation-cn",
          "geosite:apple-cn"
        ],
        "expectIPs": [
          "geoip:cn"
        ],
        "skipFallback": true
      },
      {
        "address": "local://114.114.114.114",
        "domains": [
          "geosite:cn",
          "geosite:geolocation-cn",
          "geosite:apple-cn"
        ],
        "expectIPs": [
          "geoip:cn"
        ],
        "skipFallback": true
      },
      {
        "address": "https+local://223.5.5.5/dns-query",
        "domains": [
          "geosite:cn",
          "geosite:geolocation-cn",
          "geosite:apple-cn"
        ],
        "expectIPs": [
          "geoip:cn"
        ],
        "skipFallback": false
      },
      {
        "address": "8.8.8.8",
        "domains": [
          "geosite:cn",
          "geosite:geolocation-cn",
          "geosite:apple-cn"
        ],
        "expectIPs": [
          "geoip:cn"
        ],
        "skipFallback": false,
        "clientIP": "114.114.114.114"
      }
    ],
    "queryStrategy": "UseIPv4",
    "disableCache": false,
    "disableFallback": false,
    "disableFallbackIfMatch": false
  }
}
