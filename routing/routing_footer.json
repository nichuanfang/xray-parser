{
	"domainStrategy": "IPIfNonMatch",
	"domainMatcher": "hybrid",
	"rules": [
		{
			"type": "field",
			"outboundTag": "direct",
			"domain": [
				  "geosite:geolocation-cn",
				  "geosite:cn",
				  "geosite:private",
				  "domain:ip6-localhost",
				  "domain:ip6-loopback",
				  "domain:cdn.jsdelivr.net"
			]
		},
		{
			"type": "field",
			"outboundTag": "direct",
			"ip": [
				"geoip:cn",
				"geoip:private"
			]
		}
	]
}
