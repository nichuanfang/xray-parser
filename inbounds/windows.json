{
  "listen": "0.0.0.0",
  "port": 0,
  "protocol": "vless",
  "settings": {
    "clients": [
      {
        "id": "",
        "flow": "xtls-rprx-vision"
      }
    ],
    "decryption": "none",
    "fallbacks": [
      {
        "dest": "5001",
        "xver": 1
      },
      {
        "alpn": "h2",
        "dest": "5002",
        "xver": 1
      }
    ]
  },
  "streamSettings": {
    "network": "tcp",
    "security": "tls",
    "tlsSettings": {
      "rejectUnknownSni": true,
      "minVersion": "1.2",
      "certificates": [
        {
          "ocspStapling": 3600,
          "certificateFile": "/etc/letsencrypt/live/chuanfang.org/fullchain.pem",
          "keyFile": "/etc/letsencrypt/live/chuanfang.org/privkey.pem"
        }
      ]
    },
    "sniffing": {
      "enabled": false
    }
  }
}
